{
  "name": "joepdooper/ivy",
  "description": "Yet another sleek simple fast CMS with an effortless template and plugin environment",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Joep Dooper"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../ivy-*",
      "options": {
        "symlink": true
      },
      "canonical": false
    }
  ],
  "require": {
    "php": ">=8.5.6",
    "joepdooper/ivy-roots": "dev-plugins-composer",
    "mnsami/composer-custom-directory-installer": "^2.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "joepdooper/ivy-cultivate": "dev-main",
    "kint-php/kint": "dev-master",
    "pestphp/pest": "3.x-dev",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "^1.29"
  },
  "config": {
    "platform": {
      "php": "8.5.6"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "mnsami/composer-custom-directory-installer": true
    }
  },
  "extra": {
    "installer-types": [
      "ivy-plugin",
      "ivy-template"
    ],
    "installer-paths": {
      "plugins/{$name}": ["type:ivy-plugin"],
      "templates/{$name}": ["type:ivy-template"]
    }
  }
}
